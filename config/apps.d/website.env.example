# Public-safe website configuration.
# Copy to /etc/mnscloud/webapps/apps.d/website.env and add "website" to WEBAPPS_ENABLED_APPS.

APP_NAME=website

# Served at the root of the default server, so it answers whatever domain the edge forwards
# (the website is white-label and has no fixed domain). Path apps such as /phoneweb/ and /pulse/
# keep working beside it. Only one enabled app may use APP_BASE_PATH=/.
APP_BASE_PATH=/
APP_ROUTING=static

# Install the verified prebuilt dist/ bundle published with each website GitHub Release.
APP_SOURCE=release
APP_RELEASE_REPOSITORY=manaoscloud/mnscloud-website
APP_REF=latest

# Astro fingerprints these assets; serve them with long-lived immutable caching.
APP_IMMUTABLE_PATHS=/_astro/

# Optional: restrict the site to specific host names in its own server block instead.
# APP_SERVER_NAME=www.example.com
