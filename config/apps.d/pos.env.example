# Public-safe MNSCloud POS (PDV) module configuration.
# Copy to /etc/mnscloud/webapps/apps.d/pos.env.

APP_NAME=pos
APP_BASE_PATH=/pos/
APP_PUBLIC_API_BASE_URL=/api/v1

# Install the verified prebuilt web bundle published with each POS GitHub Release. It is built with
# the same-origin API base /api/v1 and is online only (no web manifest or service worker).
APP_SOURCE=release
APP_RELEASE_REPOSITORY=manaoscloud/mnscloud-pos
APP_REF=latest

# Source build alternative (requires the Flutter SDK on this host):
# APP_SOURCE=build
# APP_REPO_URL=https://github.com/manaoscloud/mnscloud-pos.git
# APP_REF=main
# APP_BUILD_COMMAND="flutter build web --release --base-href ${APP_BASE_PATH}"
