# Public-safe Pulse module configuration.
# Copy to /etc/mnscloud/webapps/apps.d/pulse.env.

APP_NAME=pulse
APP_BASE_PATH=/pulse/
APP_PUBLIC_API_BASE_URL=/api/v1

# Install the verified prebuilt web bundle published with each Pulse GitHub Release. It is built
# with the same-origin API base /api/v1; use APP_SOURCE=build for any other API base.
APP_SOURCE=release
APP_RELEASE_REPOSITORY=manaoscloud/mnscloud-pulse
APP_REF=latest

# Source build alternative (requires the Flutter SDK on this host):
# APP_SOURCE=build
# APP_REPO_URL=https://github.com/manaoscloud/mnscloud-pulse.git
# APP_REF=main
# APP_BUILD_COMMAND="flutter build web --release --base-href ${APP_BASE_PATH} --dart-define PULSE_PUBLIC_API_BASE_URL=${APP_PUBLIC_API_BASE_URL}"
