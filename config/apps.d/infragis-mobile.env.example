# Public-safe InfraGIS Mobile (field app) web configuration. The path matches the app name (the
# runtime serves /<app>/ from current/<app>); /infragis/ belongs to the App InfraGIS pages.
# Copy to /etc/mnscloud/webapps/apps.d/infragis-mobile.env.

APP_NAME=infragis-mobile
APP_BASE_PATH=/infragis-mobile/
APP_PUBLIC_API_BASE_URL=/api/v1

# Install the verified prebuilt web bundle (installable PWA) published with each InfraGIS Mobile
# GitHub Release. It uses the same-origin API base /api/v1.
APP_SOURCE=release
APP_RELEASE_REPOSITORY=manaoscloud/mnscloud-infragis-mobile
APP_REF=latest
