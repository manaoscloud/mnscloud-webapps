# Public-safe PhoneWeb module configuration.
# Copy to /etc/mnscloud/webapps/apps.d/phoneweb.env.

APP_NAME=phoneweb
APP_BASE_PATH=/phoneweb/

# Install the verified prebuilt web bundle published with each PhoneWeb GitHub Release.
# APP_REF is "latest" or a pinned release tag such as v0.1.57.
APP_SOURCE=release
APP_RELEASE_REPOSITORY=manaoscloud/mnscloud-phoneweb
APP_REF=latest

# Source build alternative (requires the Flutter SDK on this host):
# APP_SOURCE=build
# APP_REPO_URL=https://github.com/manaoscloud/mnscloud-phoneweb.git
# APP_REF=main
# APP_BUILD_COMMAND="flutter build web --release --base-href ${APP_BASE_PATH}"
