# Public-safe Customer Portal configuration.
# Copy to /etc/mnscloud/webapps/apps.d/customer-portal.env.

APP_NAME=customer-portal
APP_BASE_PATH=/customer-portal/

# Install the verified prebuilt web bundle published with each Customer Portal GitHub Release.
# APP_REF is "latest" or a pinned release tag such as v0.1.3.
APP_SOURCE=release
APP_RELEASE_REPOSITORY=manaoscloud/mnscloud-customer-portal
APP_REF=latest
APP_ROUTING=spa
