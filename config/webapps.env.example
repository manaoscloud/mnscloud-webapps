# MNSCloud WebApps private runtime environment.
# Copy to /etc/mnscloud/webapps/webapps.env and replace placeholders.

WEBAPPS_ROOT=/opt/mnscloud/webapps
WEBAPPS_ENV_DIR=/etc/mnscloud/webapps
WEBAPPS_APPS_DIR=/etc/mnscloud/webapps/apps.d
# Use the private address the edge reaches when mnscloud-nginx runs on another host.
WEBAPPS_LISTEN_HOST=127.0.0.1
WEBAPPS_LISTEN_PORT=8080
# Comma-separated client IPs/CIDRs allowed to reach the listener (for example the edge host).
# Loopback and the listen address are always allowed. Empty = no allowlist (use the firewall).
WEBAPPS_ALLOWED_CLIENTS=
WEBAPPS_USER=mnscloud-webapps
WEBAPPS_GROUP=mnscloud-webapps
WEBAPPS_RUNTIME_KIT_DIR=/opt/mnscloud/runtime-kit
WEBAPPS_RUNTIME_KIT_REPO_URL=https://github.com/manaoscloud/mnscloud-runtime-kit.git
WEBAPPS_RUNTIME_KIT_CHANNEL=stable
WEBAPPS_RUNTIME_KIT_REF=
# auto = install Flutter only when an enabled app uses APP_SOURCE=build.
WEBAPPS_INSTALL_FLUTTER=auto
WEBAPPS_FLUTTER_DIR=/opt/flutter
WEBAPPS_FLUTTER_CHANNEL=stable
WEBAPPS_FLUTTER_BUILD_PROFILE=web
WEBAPPS_FLUTTER_RUN_USER=mnscloud-webapps
WEBAPPS_FLUTTER_HOME=/var/lib/mnscloud-webapps/flutter

# Comma-separated app names to update when --app is not supplied.
WEBAPPS_ENABLED_APPS=phoneweb,pulse

# Previous release directories kept per app for rollback, in addition to the active one.
WEBAPPS_KEEP_RELEASES=5

# Periodically converge APP_SOURCE=release apps to APP_REF (pinned tag or "latest").
# Keep false where app promotion must stay manual (for example production).
WEBAPPS_AUTO_SYNC=false
WEBAPPS_AUTO_SYNC_INTERVAL=15min

# Optional control-plane base URL used by update-latest-webapps.sh to resolve the approved
# runtime release. Empty = latest Git tag.
WEBAPPS_RELEASE_API_BASE_URL=
