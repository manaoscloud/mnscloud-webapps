worker_processes auto;
pid {{WEBAPPS_ROOT}}/runtime/nginx.pid;
error_log {{WEBAPPS_ROOT}}/runtime/logs/error.log warn;

events {
  worker_connections 1024;
}

http {
  server_tokens off;
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log {{WEBAPPS_ROOT}}/runtime/logs/access.log;
  sendfile on;
  keepalive_timeout 30s;
  client_max_body_size 10m;

  # Client allowlist rendered from WEBAPPS_ALLOWED_CLIENTS (applies to every server below).
  include {{WEBAPPS_ENV_DIR}}/nginx/access.conf;

  server {
    listen {{WEBAPPS_LISTEN_HOST}}:{{WEBAPPS_LISTEN_PORT}} default_server;
    server_name _;

    location = /healthz {
      return 200 'ok';
      add_header Content-Type text/plain;
    }

    location ~* (^|/)(\.env|\.git|\.svn|\.hg|package-lock\.json|yarn\.lock|pnpm-lock\.yaml)$ {
      return 404;
    }

    location ~ (^|/)\. {
      return 404;
    }

    # Path-based apps (APP_BASE_PATH such as /phoneweb/) and at most one root app (APP_BASE_PATH=/),
    # which answers any Host forwarded by the edge.
    include {{WEBAPPS_ENV_DIR}}/nginx/apps/*.conf;
  }

  # Host-based apps served at the root of their own domain (APP_SERVER_NAME).
  include {{WEBAPPS_ENV_DIR}}/nginx/servers/*.conf;
}
